(() => {

  /* =========================
     HELPERS
  ========================= */

  function romanWordToNumber(text) {

    const map = {
      one: 1,
      two: 2,
      three: 3,
      four: 4,
      five: 5,
      six: 6
    };

    return map[
      String(text)
        .trim()
        .toLowerCase()
    ] || null;

  }


  function cleanText(text) {

    return String(text || "")
      .replace(/\s+/g, " ")
      .trim();

  }


  /* =========================
     FIND ALL VOD LINKS
  ========================= */

  const vodLinks =
    [...document.querySelectorAll("a")]
      .filter(link =>
        link.textContent
          .trim()
          .toLowerCase() === "vod"
      );


  if (vodLinks.length === 0) {

    console.warn(
      "No VOD links were found on this page."
    );

    return;

  }


  /* =========================
     DETECT CAMPAIGN
  ========================= */

  const campaignCounts =
    new Map();


  vodLinks.forEach(link => {

    const row =
      link.closest("tr");

    if (!row) {
      return;
    }


    const text =
      cleanText(
        row.innerText
      );


    const match =
      text.match(
        /\((\d+)x\d+\)/i
      );


    if (!match) {
      return;
    }


    const campaign =
      Number(match[1]);


    campaignCounts.set(
      campaign,
      (
        campaignCounts.get(
          campaign
        ) || 0
      ) + 1
    );

  });


  if (
    campaignCounts.size === 0
  ) {

    console.warn(
      "Could not detect a campaign number from the episode rows."
    );

    return;

  }


  const CAMPAIGN =
    [...campaignCounts.entries()]
      .sort(
        (a, b) =>
          b[1] - a[1]
      )[0][0];


  console.log(
    `✓ Detected Campaign ${CAMPAIGN}`
  );


  /* =========================
     DETECT ARC
  ========================= */

  const pageTitle =
    cleanText(
      document.querySelector("h1")
        ?.innerText ||
      document.title
    );


  let ARC = null;


  /*
    Matches things like:
    Arc 3
    Arc III
  */

  const numericArc =
    pageTitle.match(
      /\bArc\s+(\d+)\b/i
    );


  if (numericArc) {

    ARC =
      Number(
        numericArc[1]
      );

  }


  /*
    Try Roman numerals if needed.
  */

  if (!ARC) {

    const romanArc =
      pageTitle.match(
        /\bArc\s+([IVX]+)\b/i
      );


    if (romanArc) {

      const roman =
        romanArc[1]
          .toUpperCase();


      const romanMap = {
        I: 1,
        II: 2,
        III: 3,
        IV: 4,
        V: 5,
        VI: 6,
        VII: 7,
        VIII: 8,
        IX: 9,
        X: 10
      };


      ARC =
        romanMap[roman] ||
        null;

    }

  }


  /*
    Try written campaign-style wording
    if Fandom uses something unusual.
  */

  if (!ARC) {

    const wordArc =
      pageTitle.match(
        /\bArc\s+(One|Two|Three|Four|Five|Six)\b/i
      );


    if (wordArc) {

      ARC =
        romanWordToNumber(
          wordArc[1]
        );

    }

  }


  if (!ARC) {

    console.warn(
      "Could not automatically detect the arc number."
    );

    console.warn(
      `Page title was: "${pageTitle}"`
    );

    console.warn(
      "You can manually set ARC near the top of the script if needed."
    );

    return;

  }


  console.log(
    `✓ Detected Arc ${ARC}`
  );


  /* =========================
     READ EPISODES
  ========================= */

  const episodes = [];


  vodLinks.forEach(link => {

    const row =
      link.closest("tr");

    if (!row) {
      return;
    }


    const rowText =
      cleanText(
        row.innerText
      );


    const episodeCodePattern =
      new RegExp(
        `\\(${CAMPAIGN}x(\\d+)\\)`,
        "i"
      );


    const episodeCode =
      rowText.match(
        episodeCodePattern
      );


    if (!episodeCode) {
      return;
    }


    const episodeNumber =
      Number(
        episodeCode[1]
      );


    /* =========================
       TITLE
    ========================= */

    const titlePattern =
      new RegExp(
        `["“](.+?)["”]\\s*\\(${CAMPAIGN}x\\d+\\)`,
        "i"
      );


    const titleMatch =
      rowText.match(
        titlePattern
      );


    const title =
      titleMatch
        ? cleanText(
            titleMatch[1]
          )
        : "";


    /* =========================
       RUNTIME
    ========================= */

    const runtimeMatch =
      rowText.match(
        /\b\d{1,2}:\d{2}:\d{2}\b/
      );


    const duration =
      runtimeMatch
        ? runtimeMatch[0]
        : "";


    /* =========================
       VOD
    ========================= */

    const youtube =
      link.href || "";


    /* =========================
       DESCRIPTION
    ========================= */

    let description = "";


    const nextRow =
      row.nextElementSibling;


    if (nextRow) {

      const nextText =
        cleanText(
          nextRow.innerText
        );


      const nextEpisodePattern =
        new RegExp(
          `\\(${CAMPAIGN}x\\d+\\)`,
          "i"
        );


      const nextIsEpisode =
        nextEpisodePattern.test(
          nextText
        );


      if (
        nextText &&
        !nextIsEpisode &&
        nextText.length > 20
      ) {

        description =
          nextText;

      }

    }


    episodes.push({

      id:
        `c${CAMPAIGN}e${episodeNumber}`,

      campaign:
        CAMPAIGN,

      arc:
        ARC,

      episode:
        episodeNumber,

      label:
        `Campaign ${CAMPAIGN} • Episode ${episodeNumber}`,

      title,

      duration,

      description,

      youtube

    });

  });


  /* =========================
     REMOVE DUPLICATES
  ========================= */

  const uniqueEpisodes =
    [
      ...new Map(
        episodes.map(
          episode => [
            episode.id,
            episode
          ]
        )
      ).values()
    ];


  uniqueEpisodes.sort(
    (a, b) =>
      a.episode - b.episode
  );


  if (
    uniqueEpisodes.length === 0
  ) {

    console.warn(
      `No Campaign ${CAMPAIGN} episodes were successfully extracted.`
    );

    return;

  }


  /* =========================
     RANGE + GAP CHECK
  ========================= */

  const firstEpisode =
    uniqueEpisodes[0].episode;


  const lastEpisode =
    uniqueEpisodes[
      uniqueEpisodes.length - 1
    ].episode;


  console.log(
    `✓ Detected C${CAMPAIGN}E${firstEpisode}–C${CAMPAIGN}E${lastEpisode}`
  );


  console.log(
    `✓ ${uniqueEpisodes.length} episodes found`
  );


  const foundNumbers =
    new Set(
      uniqueEpisodes.map(
        episode =>
          episode.episode
      )
    );


  const missingEpisodes = [];


  for (
    let episode = firstEpisode;
    episode <= lastEpisode;
    episode++
  ) {

    if (
      !foundNumbers.has(
        episode
      )
    ) {

      missingEpisodes.push(
        episode
      );

    }

  }


  if (
    missingEpisodes.length
  ) {

    console.warn(
      "⚠ Missing episode numbers:",
      missingEpisodes
    );

  } else {

    console.log(
      "✓ No gaps detected"
    );

  }


  /* =========================
     DATA QUALITY CHECK
  ========================= */

  const incomplete =
    uniqueEpisodes.filter(
      episode =>
        !episode.title ||
        !episode.duration ||
        !episode.youtube ||
        !episode.description
    );


  if (
    incomplete.length > 0
  ) {

    console.warn(
      `⚠ ${incomplete.length} episodes have missing data.`
    );


    console.table(
      incomplete.map(
        episode => ({

          episode:
            episode.episode,

          title:
            episode.title
              ? "✓"
              : "MISSING",

          duration:
            episode.duration
              ? "✓"
              : "MISSING",

          youtube:
            episode.youtube
              ? "✓"
              : "MISSING",

          description:
            episode.description
              ? "✓"
              : "MISSING"

        })
      )
    );

  } else {

    console.log(
      "✓ Every episode has title, runtime, VOD, and description"
    );

  }


  /* =========================
     PREVIEW
  ========================= */

  console.table(
    uniqueEpisodes.map(
      episode => ({

        episode:
          episode.episode,

        title:
          episode.title,

        duration:
          episode.duration,

        youtube:
          episode.youtube
            ? "✓"
            : "—",

        description:
          episode.description
            ? "✓"
            : "—"

      })
    )
  );


  /* =========================
     GENERATE OUTPUT
  ========================= */

  const output =
    uniqueEpisodes
      .map(
        episode =>
          JSON.stringify(
            episode,
            null,
            2
          )
      )
      .join(",\n\n");


  /* =========================
     COPY
  ========================= */

  if (
    typeof copy === "function"
  ) {

    copy(output);

    console.log(
      `✓ Copied ${uniqueEpisodes.length} paste-ready episode objects!`
    );

  } else {

    console.log(
      "\nPASTE-READY DATA:\n\n" +
      output
    );

  }


  /* =========================
     SUMMARY
  ========================= */

  console.log(
    "━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  );

  console.log(
    `Campaign: ${CAMPAIGN}`
  );

  console.log(
    `Arc: ${ARC}`
  );

  console.log(
    `Range: C${CAMPAIGN}E${firstEpisode}–C${CAMPAIGN}E${lastEpisode}`
  );

  console.log(
    `Episodes: ${uniqueEpisodes.length}`
  );

})();
