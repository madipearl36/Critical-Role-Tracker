(() => {

  /* =========================
     ONLY CHANGE THESE
  ========================= */

  const CAMPAIGN = 2;
  const ARC = 1;


  /* =========================
     FIND VOD LINKS
  ========================= */

  const vodLinks =
    [...document.querySelectorAll("a")]
      .filter(link =>
        link.textContent
          .trim()
          .toLowerCase() === "vod"
      );


  const episodes = [];


  /* =========================
     READ EPISODE ROWS
  ========================= */

  vodLinks.forEach(link => {

    const row =
      link.closest("tr");

    if (!row) {
      return;
    }


    const rowText =
      row.innerText
        .replace(/\s+/g, " ")
        .trim();


    /*
      Match only this campaign:
      (3x52), (3x53), etc.
    */

    const episodeCodePattern =
      new RegExp(
        `\\(${CAMPAIGN}x(\\d+)\\)`,
        "i"
      );


    const episodeCode =
      rowText.match(
        episodeCodePattern
      );


    if (!episodeCode) {
      return;
    }


    const episodeNumber =
      Number(
        episodeCode[1]
      );


    /* =========================
       TITLE
    ========================= */

    const titlePattern =
      new RegExp(
        `["“](.+?)["”]\\s*\\(${CAMPAIGN}x\\d+\\)`,
        "i"
      );


    const titleMatch =
      rowText.match(
        titlePattern
      );


    const title =
      titleMatch
        ? titleMatch[1].trim()
        : "";


    /* =========================
       RUNTIME
    ========================= */

    const runtimeMatch =
      rowText.match(
        /\b\d{1,2}:\d{2}:\d{2}\b/
      );


    const duration =
      runtimeMatch
        ? runtimeMatch[0]
        : "";


    /* =========================
       YOUTUBE
    ========================= */

    const youtube =
      link.href || "";


    /* =========================
       DESCRIPTION
    ========================= */

    let description = "";


    const nextRow =
      row.nextElementSibling;


    if (nextRow) {

      const nextText =
        nextRow.innerText
          ?.replace(/\s+/g, " ")
          ?.trim();


      const nextEpisodePattern =
        new RegExp(
          `\\(${CAMPAIGN}x\\d+\\)`,
          "i"
        );


      const nextIsEpisode =
        nextEpisodePattern.test(
          nextText || ""
        );


      if (
        nextText &&
        !nextIsEpisode &&
        nextText.length > 20
      ) {

        description =
          nextText;

      }

    }


    /* =========================
       ADD EPISODE
    ========================= */

    episodes.push({

      id:
        `c${CAMPAIGN}e${episodeNumber}`,

      campaign:
        CAMPAIGN,

      arc:
        ARC,

      episode:
        episodeNumber,

      label:
        `Campaign ${CAMPAIGN} • Episode ${episodeNumber}`,

      title,

      duration,

      description,

      youtube

    });

  });


  /* =========================
     REMOVE DUPLICATES
  ========================= */

  const uniqueEpisodes =
    [
      ...new Map(
        episodes.map(
          episode => [
            episode.id,
            episode
          ]
        )
      ).values()
    ];


  /* =========================
     SORT
  ========================= */

  uniqueEpisodes.sort(
    (a, b) =>
      a.episode - b.episode
  );


  /* =========================
     DETECT RANGE
  ========================= */

  if (
    uniqueEpisodes.length === 0
  ) {

    console.warn(
      `No Campaign ${CAMPAIGN} episode VODs were found on this page.`
    );

    console.warn(
      "Make sure you're on the correct Critical Role Wiki arc page."
    );

    return;

  }


  const firstEpisode =
    uniqueEpisodes[0].episode;


  const lastEpisode =
    uniqueEpisodes[
      uniqueEpisodes.length - 1
    ].episode;


  console.log(
    `✓ Detected Campaign ${CAMPAIGN}, Arc ${ARC}`
  );

  console.log(
    `✓ C${CAMPAIGN}E${firstEpisode}–C${CAMPAIGN}E${lastEpisode}`
  );

  console.log(
    `✓ ${uniqueEpisodes.length} episodes found`
  );


  /* =========================
     CHECK FOR MISSING EPISODES
  ========================= */

  const expectedEpisodes = [];


  for (
    let episode = firstEpisode;
    episode <= lastEpisode;
    episode++
  ) {

    expectedEpisodes.push(
      episode
    );

  }


  const foundNumbers =
    new Set(
      uniqueEpisodes.map(
        episode =>
          episode.episode
      )
    );


  const missingEpisodes =
    expectedEpisodes.filter(
      episode =>
        !foundNumbers.has(
          episode
        )
    );


  if (
    missingEpisodes.length > 0
  ) {

    console.warn(
      "⚠ Missing episode numbers:",
      missingEpisodes
    );

  } else {

    console.log(
      "✓ No gaps detected in the episode range"
    );

  }


  /* =========================
     PREVIEW
  ========================= */

  console.table(
    uniqueEpisodes.map(
      episode => ({

        episode:
          episode.episode,

        title:
          episode.title,

        duration:
          episode.duration,

        youtube:
          episode.youtube
            ? "✓"
            : "—",

        description:
          episode.description
            ? "✓"
            : "—"

      })
    )
  );


  /* =========================
     GENERATE CODE
  ========================= */

  const output =
    uniqueEpisodes
      .map(
        episode =>
          JSON.stringify(
            episode,
            null,
            2
          )
      )
      .join(",\n\n");


  /* =========================
     COPY
  ========================= */

  if (
    typeof copy === "function"
  ) {

    copy(output);

    console.log(
      `✓ Copied ${uniqueEpisodes.length} episodes to clipboard!`
    );

  } else {

    console.log(
      "\nPASTE-READY DATA:\n\n" +
      output
    );

  }

})();
